# Copy this file to config.env and fill in the two values below.
# Make sure to never commit or email the config.env file

# The mediator's base URL.
# Test instance example:  https://my-test-server
# Local demo stack:       https://localhost:9070
MEDIATOR_URL=

# The PulseTech API key, provided by the integration team.
MEDIATOR_API_KEY_PULSETECH=

# Set to false only if the mediator uses a self-signed certificate
# (the local demo stack does; a real server should not).
MEDIATOR_TLS_VERIFY=true
